  const offerRematch = useCallback(() => {
    sendRematchOffer();
  }, [sendRematchOffer]);

  const acceptRematch = useCallback(() => {
    sendAcceptRematch();
  }, [sendAcceptRematch]);

  const declineRematch = useCallback(() => {
