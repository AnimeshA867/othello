    const isProduction = process.env.NODE_ENV === "production";
    const env = isProduction ? "production" : "development";
    const { protocol, host, port } = config.wsServer[env];

    console.log(
      `Building WebSocket URL with protocol: ${protocol}, host: ${host}, port: ${
        port || "none"
