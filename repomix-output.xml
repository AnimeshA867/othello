  const acceptDraw = useCallback(() => {
    sendAcceptDraw();
  }, [sendAcceptDraw]);

  const declineDraw = useCallback(() => {
    sendDeclineDraw();
  }, [sendDeclineDraw]);

  return {
    gameState,
    makeMove,
    restartGame,
    resignGame,
    abandonGame,
    offerDraw,
    acceptDraw,
    declineDraw,
    joinRandomGame,
    createRoom,
    joinRoom,
    disconnect,
    leaveRoom,
    websocketState,
  };
}
</file>

