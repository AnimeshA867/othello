  }, [sendRestart]);

  const resignGame = useCallback(() => {
    sendResign();
  }, [sendResign]);
  const abandonGame = useCallback(() => {
    sendAbandon();
  }, [sendAbandon]);

  const offerDraw = useCallback(() => {
    sendDrawOffer();
  }, [sendDrawOffer]);

  const acceptDraw = useCallback(() => {
    sendAcceptDraw();
